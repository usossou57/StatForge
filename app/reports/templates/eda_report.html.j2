<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rapport EDA — {{ dataset_name }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            line-height: 1.6;
        }
        h1 { color: #2c3e50; border-bottom: 3px solid #3498db; padding-bottom: 10px; }
        h2 { color: #34495e; margin-top: 30px; border-bottom: 2px solid #bdc3c7; padding-bottom: 5px; }
        h3 { color: #7f8c8d; }
        table {
            border-collapse: collapse;
            width: 100%;
            margin: 15px 0;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: left;
        }
        th { background-color: #3498db; color: white; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        img {
            max-width: 100%;
            height: auto;
            border: 1px solid #ddd;
            border-radius: 4px;
            margin: 10px 0;
        }
        .status-normal { color: #27ae60; font-weight: bold; }
        .status-non-normal { color: #e74c3c; font-weight: bold; }
        .info-box {
            background-color: #ecf0f1;
            padding: 15px;
            border-left: 4px solid #3498db;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <h1>Rapport EDA — {{ dataset_name }}</h1>

    <h2>1. Profil du dataset</h2>
    <div class="info-box">
        <p><strong>Nombre de lignes :</strong> {{ profile.n_rows }}</p>
        <p><strong>Nombre de colonnes :</strong> {{ profile.n_columns }}</p>
    </div>

    <h3>Types de données</h3>
    <table>
        <thead>
            <tr>
                <th>Colonne</th>
                <th>Type</th>
            </tr>
        </thead>
        <tbody>
            {% for col, dtype in profile.dtypes.items() %}
            <tr>
                <td>{{ col }}</td>
                <td>{{ dtype }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h2>2. Valeurs manquantes</h2>
    <table>
        <thead>
            <tr>
                <th>Colonne</th>
                <th>Nb manquants</th>
                <th>% manquants</th>
            </tr>
        </thead>
        <tbody>
            {% for col, info in missing_info.items() %}
            <tr>
                <td>{{ col }}</td>
                <td>{{ info.n_missing }}</td>
                <td>{{ info.pct_missing }}%</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if summary_data %}
    <h2>3. Résumé descriptif</h2>
    {% for summary in summary_data %}
    <h3>{{ summary.variable }}</h3>
    <table>
        <tbody>
            {% for key, value in summary.items() %}
            {% if key != 'variable' %}
            <tr>
                <td><strong>{{ key }}</strong></td>
                <td>{{ value }}</td>
            </tr>
            {% endif %}
            {% endfor %}
        </tbody>
    </table>
    {% endfor %}
    {% endif %}

    {% if correlation_result %}
    <h2>4. Corrélations</h2>
    {% if correlation_plot %}
    <img src="{{ correlation_plot }}" alt="Heatmap de corrélation">
    {% endif %}
    {% endif %}

    {% if normality_results %}
    <h2>5. Tests de normalité</h2>
    <table>
        <thead>
            <tr>
                <th>Variable</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for norm in normality_results %}
            <tr>
                <td>{{ norm.column }}</td>
                <td>
                    {% if norm.is_normal %}
                    <span class="status-normal">✅ Normale</span>
                    {% else %}
                    <span class="status-non-normal">❌ Non normale</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {% if outlier_results %}
    <h2>6. Détection d'outliers (IQR)</h2>
    <table>
        <thead>
            <tr>
                <th>Variable</th>
                <th>Nb outliers</th>
            </tr>
        </thead>
        <tbody>
            {% for outlier in outlier_results %}
            <tr>
                <td>{{ outlier.column }}</td>
                <td>{{ outlier.n_outliers }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    {% if histogram_plots %}
    <h2>7. Distributions</h2>
    {% for col, img_base64 in histogram_plots.items() %}
    <h3>{{ col }}</h3>
    <img src="{{ img_base64 }}" alt="Histogramme de {{ col }}">
    {% endfor %}
    {% endif %}

    {% if boxplot_plots %}
    <h2>8. Boxplots</h2>
    {% for key, img_base64 in boxplot_plots.items() %}
    <h3>{{ key }}</h3>
    <img src="{{ img_base64 }}" alt="Boxplot {{ key }}">
    {% endfor %}
    {% endif %}

    <footer style="margin-top: 50px; padding-top: 20px; border-top: 1px solid #ddd; color: #7f8c8d; font-size: 0.9em;">
        <p>Rapport généré automatiquement par Statistical IDE — Phase 16</p>
    </footer>
</body>
</html>
